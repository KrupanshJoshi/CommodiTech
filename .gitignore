# ==========================================
# Commodity Compliance Scanner - .gitignore
# ==========================================

# --- Environment & Secret Variables ---
.env
.env.*
!.env.example
.env*.local
*.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# --- Virtual Environments ---
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# --- Testing & Code Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
nosetests.xml

# --- Node / Frontend (Vite & Next.js) ---
node_modules/
dist/
dist-ssr/
out/
.next/
.turbo/
.parcel-cache/
.pnpm-store/
.npm/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Project Specific Data & Uploads ---
*.db
*.sqlite
*.sqlite3
backend/database/*.db

# Uploaded test images and generated compliance reports (keep directory via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# Archives / Backups
*.zip
*.tar.gz
*.rar
*.7z
*.bak

# --- v0 / Vercel / Sandbox Artifacts ---
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# --- IDE & Editor Settings ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

