# Copy this file to .env and adjust values before running the app.

# --- Flask ---
FLASK_CONFIG=default
FLASK_DEBUG=true
PORT=5000

# --- Security ---
# Change these before any real deployment.
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_EXPIRES_HOURS=24

# --- Database ---
# Leave unset to use the local SQLite fallback. For Supabase, use the direct
# PostgreSQL URI with sslmode=require; URL-encode special password characters.
# DATABASE_URL=postgresql+psycopg://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require

# --- File storage ---
UPLOAD_FOLDER=backend/uploads
REPORT_FOLDER=backend/reports
MAX_UPLOAD_SIZE_MB=10

# --- OCR ---
# Leave unset to auto-detect tesseract on PATH. Set explicitly on Windows, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_MIN_WORD_CONFIDENCE=45
OCR_LOW_CONFIDENCE_THRESHOLD=60

# --- AI-Assisted Semantic Field Extractor ---
# Options: gemini, openai, mock_testing
AI_PROVIDER=gemini
# Put your Google Gemini API key or OpenAI key here:
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=12

# --- CORS ---
# Comma-separated browser origins allowed to call /api. The defaults in code
# permit the local Vite server only. For a separately hosted frontend, set its
# exact HTTPS URL here (no trailing slash), e.g. https://app.example.com.
# Docker's bundled frontend is same-origin and needs no CORS setting.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
